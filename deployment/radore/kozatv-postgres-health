#!/usr/bin/env bash
set -Eeuo pipefail

database="${KOZA_DATABASE_NAME:-kozatv}"
data_dir="${KOZA_DATA_DIR:-/srv/kozatv/data}"
backup_root="${KOZA_BACKUP_DIR:-/srv/kozatv/backups}"
max_disk="${KOZA_MAX_DISK_PERCENT:-85}"
max_backup_age_minutes="${KOZA_MAX_BACKUP_AGE_MINUTES:-1800}"
status_file="${KOZA_SYSTEM_HEALTH_PATH:-$data_dir/system-health.json}"

used=100
article_count=0
media_count=0
media_files=0
latest_backup_at=0
postgresql_ok=false
application_ok=false
proxy_ok=false

write_snapshot() {
  local snapshot_status="$1"
  local checked_at_ms temporary
  checked_at_ms="$(date +%s)000"
  temporary="${status_file}.tmp.$$"
  install -d -o kozatv -g kozatv -m 0750 "$data_dir"
  printf '{"version":1,"status":"%s","checkedAt":%s,"diskUsedPercent":%s,"articleCount":%s,"mediaRecordCount":%s,"mediaFileCount":%s,"latestBackupAt":%s,"services":{"postgresql":%s,"application":%s,"proxy":%s}}\n' \
    "$snapshot_status" "$checked_at_ms" "$used" "$article_count" "$media_count" "$media_files" "$latest_backup_at" "$postgresql_ok" "$application_ok" "$proxy_ok" > "$temporary"
  install -o kozatv -g kozatv -m 0600 "$temporary" "$status_file"
  rm -f -- "$temporary"
}

record_failure() {
  local exit_code="$?"
  trap - EXIT
  set +e
  write_snapshot critical
  exit "$exit_code"
}
trap record_failure EXIT

used="$(df --output=pcent /srv/kozatv | tail -1 | tr -dc '0-9')"
[[ "$used" =~ ^[0-9]+$ && "$used" -lt "$max_disk" ]] || { echo "ALARM: Koza TV disk kullanımı %${used:-bilinmiyor}" >&2; exit 1; }

systemctl is-active --quiet postgresql.service
postgresql_ok=true
systemctl is-active --quiet kozatv.service
application_ok=true
systemctl is-active --quiet caddy.service
proxy_ok=true
runuser -u kozatv -- pg_isready --dbname="$database" --quiet

database_status="$(runuser -u kozatv -- psql --dbname="$database" -Atqc "SELECT (SELECT COUNT(*) FROM articles) || '|' || (SELECT COUNT(*) FROM media_assets)")"
[[ "$database_status" =~ ^[0-9]+\|[0-9]+$ ]] || { echo "ALARM: PostgreSQL sayımları okunamadı." >&2; exit 1; }

home_status="$(curl --silent --show-error --output /dev/null --write-out '%{http_code}' http://127.0.0.1:8201/)"
auth_status="$(curl --silent --show-error --output /dev/null --write-out '%{http_code}' http://127.0.0.1:8201/api/auth/me)"
[[ "$home_status" == "200" ]] || { echo "ALARM: Ana sayfa HTTP $home_status" >&2; exit 1; }
[[ "$auth_status" == "401" ]] || { echo "ALARM: Yetkisiz oturum ucu HTTP $auth_status" >&2; exit 1; }

IFS='|' read -r article_count media_count <<< "$database_status"
media_files="$(find "$data_dir/media" -type f | wc -l)"
(( media_files >= media_count )) || { echo "ALARM: Medya dosyası sayısı kayıttan az: files=$media_files db=$media_count" >&2; exit 1; }

latest_backup=""
while IFS= read -r backup_candidate; do
  [[ -s "$backup_candidate/kozatv.dump" && -s "$backup_candidate/media.tar.gz" && -s "$backup_candidate/SHA256SUMS" ]] || continue
  latest_backup="$backup_candidate"
  break
done < <(find "$backup_root/daily" -mindepth 1 -maxdepth 1 -type d -mmin "-$max_backup_age_minutes" -printf '%T@ %p\n' | sort -nr | cut -d' ' -f2-)
[[ -n "$latest_backup" ]] || {
  echo "ALARM: Son $max_backup_age_minutes dakika içinde eksiksiz günlük yedek yok." >&2
  exit 1
}
latest_backup_at="$(($(stat -c %Y "$latest_backup") * 1000))"

write_snapshot healthy
trap - EXIT
echo "Koza TV sağlık kontrolü başarılı: disk=%$used articles=$article_count media=$media_count files=$media_files"
