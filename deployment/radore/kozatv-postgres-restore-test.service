[Unit]
Description=Koza TV aylik PostgreSQL geri yukleme testi
After=postgresql.service kozatv-postgres-backup.service
Requires=postgresql.service

[Service]
Type=oneshot
User=root
ExecStart=/usr/local/sbin/kozatv-postgres-restore-test
